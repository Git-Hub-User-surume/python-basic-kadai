        "def calc_tax_inclusive_price(price, tax_rate):\n",
        "    tax_included_rate = 1 + tax_rate / 100\n",
        "    return price * tax_included_rate\n",
        "\n",
        "price = 110\n",
        "tax_rate = 10\n",
        "print(calc_tax_inclusive_price(price, tax_rate))\n"
      ]
    }
