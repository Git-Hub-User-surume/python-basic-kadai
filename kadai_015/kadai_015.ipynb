      "source": [
        "class Human:\n",
        "  def __init__(self, name, age):\n",
        "    self.name = name\n",
        "    self.age = age\n",
        "\n",
        "  def printinfo(self):\n",
        "    print(\"name\" + self.name + \"/age\" + str(self.age))\n",
        "\n",
        "human = Human(\"侍ニ郎\", 10)\n",
        "\n",
        "human.printinfo()\n",
        "\n",
        "\n"
      ]
    }
  ]
